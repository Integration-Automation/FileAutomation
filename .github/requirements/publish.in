# Tools the two publish jobs run: publish-dev in ci-dev.yml and publish in publish.yml. Their version
# scripts use the standard library only. publish.txt is generated from this file, for the Python 3.12
# on Linux those jobs set up:
#   uv pip compile .github/requirements/publish.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --only-binary :all: --exclude-newer <a week ago, as 2026-09-24T00:00:00Z> -o .github/requirements/publish.txt
# --exclude-newer leaves out releases under a week old, the wait dependabot.yml sets.
build
twine
